<UserControl x:Class="Modbus.App.Views.MasterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400">

    <Grid Background="{StaticResource AppBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================================ -->
        <!-- ÜST DURUM ÇUBUĞU                                                -->
        <!-- ================================================================ -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Master Modu"
                               Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Modbus cihazlarına bağlanın, register okuyun ve yazın"
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <!-- Bağlantı durumu badge -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Margin="0,0,12,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StatusBadge}">
                                <Setter Property="Background" Value="{StaticResource AccentRedLightBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ClientStatus}" Value="Bağlandı">
                                        <Setter Property="Background" Value="{StaticResource AccentGreenLightBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource AccentRedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ClientStatus}" Value="Bağlandı">
                                                <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ClientStatus}"
                                       FontSize="12"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ClientStatus}" Value="Bağlandı">
                                                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Button Content="↩ Mod Değiştir"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding NavigateToRoleSelectionCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================ -->
        <!-- ANA İÇERİK                                                      -->
        <!-- ================================================================ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,16,24,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============================================ -->
                <!-- SOL KOLON: Bağlantı + İstek Ayarları        -->
                <!-- ============================================ -->
                <StackPanel Grid.Column="0">

                    <!-- Bağlantı Ayarları Kartı -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="🔌  Bağlantı Ayarları"
                                       Style="{StaticResource SectionTitle}"/>

                            <Separator Style="{StaticResource CardSeparator}" Margin="0,0,0,16"/>

                            <!-- Protocol -->
                            <TextBlock Text="Protokol" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource ModernComboBox}"
                                      SelectedIndex="{Binding ClientProtocolIndex}"
                                      Margin="0,0,0,12">
                                <ComboBoxItem>Modbus TCP/IP</ComboBoxItem>
                                <ComboBoxItem>Modbus RTU</ComboBoxItem>
                            </ComboBox>

                            <!-- Unit ID -->
                            <TextBlock Text="Unit ID (Slave Adresi)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding SlaveId, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,12"/>

                            <!-- IP Address -->
                            <TextBlock Text="IP Adresi" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding ClientIpAddress, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,12"/>

                            <!-- TCP Port -->
                            <TextBlock Text="TCP Port" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding ClientPort, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,12"/>

                            <!-- COM Port -->
                            <TextBlock Text="COM Port" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding ClientComPort, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,12"/>

                            <!-- Baud Rate -->
                            <TextBlock Text="Baud Rate" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding ClientBaudRate, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,16"/>

                            <!-- Butonlar -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="Bağlan"
                                        Style="{StaticResource SuccessButton}"
                                        Command="{Binding ConnectClientCommand}"/>

                                <Button Grid.Column="2"
                                        Content="Bağlantıyı Kes"
                                        Style="{StaticResource DangerButton}"
                                        Command="{Binding DisconnectClientCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Modbus İstek Kartı -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="📤  Modbus İstek"
                                       Style="{StaticResource SectionTitle}"/>

                            <Separator Style="{StaticResource CardSeparator}" Margin="0,0,0,16"/>

                            <!-- Function Code -->
                            <TextBlock Text="Function Code" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource ModernComboBox}"
                                      SelectedIndex="{Binding FunctionIndex}"
                                      Margin="0,0,0,12">
                                <ComboBoxItem>01 — Read Coils</ComboBoxItem>
                                <ComboBoxItem>03 — Read Holding Registers</ComboBoxItem>
                                <ComboBoxItem>06 — Write Single Register</ComboBoxItem>
                            </ComboBox>

                            <!-- Address -->
                            <TextBlock Text="Başlangıç Adresi" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,12"/>

                            <!-- Quantity -->
                            <TextBlock Text="Miktar (Quantity)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,12"/>

                            <!-- Write Value -->
                            <TextBlock Text="Yazma Değeri" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding WriteValue, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,16"/>

                            <!-- Send Button -->
                            <Button Content="İstek Gönder"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding SendCommand}"/>

                            <!-- Son istek özeti -->
                            <Border Background="{StaticResource AccentBlueLightBrush}"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,12,0,0">
                                <TextBlock Text="{Binding LastRequestSummary}"
                                           Foreground="{StaticResource AccentBlueDarkBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ============================================ -->
                <!-- SAĞ KOLON: Register Watch + Paket Analizi   -->
                <!-- ============================================ -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="240"/>
                        <RowDefinition Height="*" MinHeight="300"/>
                    </Grid.RowDefinitions>

                    <!-- Register İzleme Kartı -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="📊  Register İzleme — Son Okunan Değerler"
                                       Style="{StaticResource SectionTitle}"/>

                            <DataGrid Grid.Row="1"
                                      Style="{StaticResource ModernDataGrid}"
                                      ItemsSource="{Binding ClientRegisters}"
                                      IsReadOnly="True"
                                      MinHeight="160">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridColumnHeader}"/>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Adres" Binding="{Binding Address}" Width="70"/>
                                    <DataGridTextColumn Header="İsim" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Decimal" Binding="{Binding Value}" Width="80"/>
                                    <DataGridTextColumn Header="Hex" Binding="{Binding HexValue}" Width="80"/>
                                    <DataGridTextColumn Header="Binary (16 bit)" Binding="{Binding BinaryValue}" Width="145"/>
                                    <DataGridTextColumn Header="Son Güncelleme" Binding="{Binding LastUpdated}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- İletişim Detayları Kartı -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}"
                            Margin="0,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="📋  İletişim Detayları"
                                       Style="{StaticResource SectionTitle}"/>

                            <TabControl Grid.Row="1"
                                        Style="{StaticResource ModernTabControl}">

                                <!-- Paket Alanları -->
                                <TabItem Style="{StaticResource ModernTabItem}"
                                         Header="Paket Alanları">
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- TX -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Gönderilen İstek (TX)"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBlueBrush}"
                                                       Margin="0,0,0,8"/>
                                            <DataGrid Style="{StaticResource ModernDataGrid}"
                                                      ItemsSource="{Binding RequestDetails}"
                                                      IsReadOnly="True">
                                                <DataGrid.ColumnHeaderStyle>
                                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridColumnHeader}"/>
                                                </DataGrid.ColumnHeaderStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Alan" Binding="{Binding Field}" Width="130"/>
                                                    <DataGridTextColumn Header="Değer" Binding="{Binding Value}" Width="180"/>
                                                    <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>

                                        <!-- RX -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Alınan Cevap (RX)"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentGreenBrush}"
                                                       Margin="0,0,0,8"/>
                                            <DataGrid Style="{StaticResource ModernDataGrid}"
                                                      ItemsSource="{Binding ResponseDetails}"
                                                      IsReadOnly="True">
                                                <DataGrid.ColumnHeaderStyle>
                                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridColumnHeader}"/>
                                                </DataGrid.ColumnHeaderStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Alan" Binding="{Binding Field}" Width="130"/>
                                                    <DataGridTextColumn Header="Değer" Binding="{Binding Value}" Width="180"/>
                                                    <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Grid>
                                </TabItem>

                                <!-- Ham TX / RX Trafiği -->
                                <TabItem Style="{StaticResource ModernTabItem}"
                                         Header="Ham TX / RX Trafiği">
                                    <Grid Margin="0,12,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,0,0,8">
                                            <TextBlock Text="Milisaniyeli paket günlüğü"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0"/>
                                            <Button Content="Temizle"
                                                    Style="{StaticResource OutlineButton}"
                                                    MinWidth="80"
                                                    Height="30"
                                                    Command="{Binding ClearLogCommand}"/>
                                        </StackPanel>

                                        <ListBox Grid.Row="1"
                                                 Style="{StaticResource LogListBox}"
                                                 ItemsSource="{Binding LogEntries}"
                                                 MinHeight="150"/>
                                    </Grid>
                                </TabItem>

                            </TabControl>
                        </Grid>
                    </Border>

                </Grid>

            </Grid>
        </ScrollViewer>

    </Grid>

</UserControl>
