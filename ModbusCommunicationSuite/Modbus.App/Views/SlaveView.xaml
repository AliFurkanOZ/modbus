<UserControl x:Class="Modbus.App.Views.SlaveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400">

    <Grid Background="{StaticResource AppBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================================ -->
        <!-- ÜST DURUM ÇUBUĞU                                                -->
        <!-- ================================================================ -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Slave Modu"
                               Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Sanal Modbus cihazı — Register hafızasını yönetin"
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <!-- Sunucu durum badge -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Margin="0,0,12,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StatusBadge}">
                                <Setter Property="Background" Value="{StaticResource AccentRedLightBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentGreenLightBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource AccentRedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ServerStatus}"
                                       FontSize="12"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Button Content="↩ Mod Değiştir"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding NavigateToRoleSelectionCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================ -->
        <!-- ANA İÇERİK                                                      -->
        <!-- ================================================================ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,16,24,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============================================ -->
                <!-- SOL KOLON: Sunucu Ayarları + Bilgi          -->
                <!-- ============================================ -->
                <StackPanel Grid.Column="0">

                    <!-- Sunucu Ayarları Kartı -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="⚙️  Sunucu Ayarları"
                                       Style="{StaticResource SectionTitle}"/>

                            <Separator Style="{StaticResource CardSeparator}" Margin="0,0,0,16"/>

                            <!-- Protocol -->
                            <TextBlock Text="Protokol" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="Modbus TCP/IP"
                                     IsReadOnly="True"
                                     Margin="0,0,0,12"/>

                            <!-- Listen Port -->
                            <TextBlock Text="Dinleme Portu" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding ServerPort, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,16"/>

                            <!-- Butonlar -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="Sunucuyu Başlat"
                                        Style="{StaticResource SuccessButton}"
                                        Command="{Binding StartServerCommand}"/>

                                <Button Grid.Column="2"
                                        Content="Sunucuyu Durdur"
                                        Style="{StaticResource DangerButton}"
                                        Command="{Binding StopServerCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Bilgi Kartı -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="ℹ️  Sanal Cihaz Bilgisi"
                                       Style="{StaticResource SectionTitle}"/>

                            <Separator Style="{StaticResource CardSeparator}" Margin="0,0,0,16"/>

                            <Border Background="{StaticResource AccentBlueLightBrush}"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <TextBlock Text="Bu panel gerçek bir PLC/kart yerine çalışan sanal Modbus cihazıdır."
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBlueDarkBrush}"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock Text="Register Memory tablosundaki Value hücreleri düzenlenebilir. Master tarafından FC03 ile bu değerler okunur; FC06 ile yazılırsa tablo anında güncellenir."
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,0,0,12"/>

                            <Border Background="{StaticResource AccentGreenLightBrush}"
                                    CornerRadius="8"
                                    Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Varsayılan test değerleri:"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#047857"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="Register 0 = 1234&#x0a;Register 1 = 5678&#x0a;Register 2 = 42"
                                               FontSize="12"
                                               Foreground="#047857"
                                               LineHeight="18"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ============================================ -->
                <!-- SAĞ KOLON: Register Hafızası + Log          -->
                <!-- ============================================ -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="320"/>
                        <RowDefinition Height="Auto" MinHeight="240"/>
                    </Grid.RowDefinitions>

                    <!-- Register Hafızası Kartı -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="💾  Server Register Hafızası"
                                       Style="{StaticResource SectionTitle}"/>

                            <TextBlock Grid.Row="1"
                                       Text="Value sütununa çift tıklayarak değer düzenleyebilirsiniz"
                                       Style="{StaticResource SectionSubtitle}"/>

                            <DataGrid Grid.Row="2"
                                      Style="{StaticResource ModernDataGrid}"
                                      ItemsSource="{Binding ServerRegisters}"
                                      IsReadOnly="False"
                                      MinHeight="250">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridColumnHeader}"/>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Adres"
                                                        Binding="{Binding Address}"
                                                        IsReadOnly="True"
                                                        Width="70"/>
                                    <DataGridTextColumn Header="İsim / Alias"
                                                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="*"/>
                                    <DataGridTextColumn Header="Değer"
                                                        Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="Hex"
                                                        Binding="{Binding HexValue}"
                                                        IsReadOnly="True"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="Binary"
                                                        Binding="{Binding BinaryValue}"
                                                        IsReadOnly="True"
                                                        Width="145"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Log Paneli -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}"
                            Margin="0,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="📋  Bağlantı ve Olay Günlüğü"
                                           Style="{StaticResource SectionTitle}"/>

                                <Button Grid.Column="1"
                                        Content="Temizle"
                                        Style="{StaticResource OutlineButton}"
                                        MinWidth="80"
                                        Height="30"
                                        Command="{Binding ClearLogCommand}"/>
                            </Grid>

                            <ListBox Grid.Row="1"
                                     Style="{StaticResource LogListBox}"
                                     ItemsSource="{Binding LogEntries}"
                                     MinHeight="140"/>
                        </Grid>
                    </Border>

                </Grid>

            </Grid>
        </ScrollViewer>

    </Grid>

</UserControl>
