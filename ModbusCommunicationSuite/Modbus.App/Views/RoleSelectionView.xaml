<UserControl x:Class="Modbus.App.Views.RoleSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">

    <Grid Background="{StaticResource AppBackgroundBrush}">

        <!-- Dekoratif üst gradient -->
        <Border Height="280"
                VerticalAlignment="Top">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#EFF6FF" Offset="0"/>
                    <GradientStop Color="#F5F3FF" Offset="0.5"/>
                    <GradientStop Color="#ECFDF5" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Ana içerik -->
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <!-- Logo ve başlık -->
            <StackPanel HorizontalAlignment="Center"
                        Margin="0,0,0,48">

                <!-- Uygulama ikonu -->
                <Border Width="64" Height="64"
                        CornerRadius="16"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3B82F6" Offset="0"/>
                            <GradientStop Color="#8B5CF6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="⚡"
                               FontSize="28"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Modbus Communication Suite"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Lütfen çalışma modunuzu seçin"
                           FontSize="15"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Rol kartları -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <!-- ========== MASTER KARTI ========== -->
                <Border Style="{StaticResource RoleCard}"
                        x:Name="MasterCard"
                        MouseLeftButtonDown="MasterCard_Click">
                    <StackPanel>

                        <!-- İkon -->
                        <Border Width="56" Height="56"
                                CornerRadius="14"
                                Background="{StaticResource AccentBlueLightBrush}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,20">
                            <TextBlock Text="📡"
                                       FontSize="26"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Master Modu"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="Modbus cihazlarına istek gönderin. Register okuma/yazma işlemlerini gerçekleştirin ve paket analizi yapın."
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,0,0,24"/>

                        <!-- Özellik listesi -->
                        <StackPanel Margin="0,0,0,24">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="✓" Foreground="{StaticResource AccentGreenBrush}" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Text="TCP/IP ve RTU bağlantısı" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="✓" Foreground="{StaticResource AccentGreenBrush}" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Text="Register okuma ve yazma" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓" Foreground="{StaticResource AccentGreenBrush}" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Text="Paket analizi ve log" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Content="Master Olarak Başla"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                Command="{Binding NavigateToMasterCommand}"/>
                    </StackPanel>
                </Border>

                <!-- ========== SLAVE KARTI ========== -->
                <Border Style="{StaticResource RoleCard}"
                        x:Name="SlaveCard"
                        MouseLeftButtonDown="SlaveCard_Click">
                    <StackPanel>

                        <!-- İkon -->
                        <Border Width="56" Height="56"
                                CornerRadius="14"
                                Background="{StaticResource AccentGreenLightBrush}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,20">
                            <TextBlock Text="🖥️"
                                       FontSize="26"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Slave Modu"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="Sanal Modbus cihazı olarak çalışın. Register hafızasını yönetin ve gelen isteklere cevap verin."
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,0,0,24"/>

                        <!-- Özellik listesi -->
                        <StackPanel Margin="0,0,0,24">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="✓" Foreground="{StaticResource AccentGreenBrush}" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Text="TCP/IP sunucu modu" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="✓" Foreground="{StaticResource AccentGreenBrush}" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Text="Register düzenleme" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓" Foreground="{StaticResource AccentGreenBrush}" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Text="Canlı bağlantı takibi" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Content="Slave Olarak Başla"
                                Style="{StaticResource SuccessButton}"
                                HorizontalAlignment="Stretch"
                                Command="{Binding NavigateToSlaveCommand}"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Alt bilgi -->
            <TextBlock Text="v1.0 — Modbus RTU / TCP Protocol Suite"
                       FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,32,0,0"/>

        </StackPanel>

    </Grid>

</UserControl>
