<Application x:Class="Modbus.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Modbus.App"
             xmlns:converters="clr-namespace:Modbus.App.Converters"
             StartupUri="MainWindow.xaml">
    <!--
       DÜZELTME: Eskiden x:Class="Modbus.App" ve xmlns:local="clr-namespace:Modbus" idi.
       Sorun: "Modbus.App" hem uygulama SINIFININ adı hem de bir NAMESPACE (Modbus.App.MainWindow)
       olarak kullanılıyordu. Aynı isim ikisi birden olamaz; proje derlenmiyordu.
       Çözüm: uygulama sınıfını "Modbus.App.App" yaptık, namespace'i de "Modbus.App".
       StartupUri: uygulama açılınca gösterilecek ilk pencere.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Uygulama teması: tüm renkler, fırçalar ve kontrol stilleri -->
                <ResourceDictionary Source="Themes/AppTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:ConnectionStateToColorConverter x:Key="ConnectionStateToColorConverter"/>
            <converters:RegisterTypeToColorConverter x:Key="RegisterTypeToColorConverter"/>
            <converters:AlarmLevelToColorConverter x:Key="AlarmLevelToColorConverter"/>
            <converters:NumericFormatConverter x:Key="NumericFormatConverter"/>
            <converters:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter"/>
            <converters:IntToBoolConverter x:Key="IntToBoolConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
